# =============================================================================
# AI Market Intelligence Platform — example environment file
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- Application ---------------------------------------------------------
APP_NAME="AI Market Intelligence Platform"
ENV=development                  # development | test | production
DEBUG=true
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console               # console | json

# Data mode. `mock` is FORBIDDEN when ENV=production (see docs/00-overview.md I9).
DATA_MODE=live                   # live | mock | replay

# --- API -----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8787
API_PREFIX=/api/v1
# Shared secret between the Electron shell and the backend. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
LOCAL_API_TOKEN=change-me-generate-a-random-token
CORS_ORIGINS=["http://localhost:5173"]

# --- PostgreSQL / TimescaleDB -------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=amip
POSTGRES_USER=amip
POSTGRES_PASSWORD=change-me
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20
POSTGRES_ECHO=false

# --- Redis ---------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- Universe (Milestone 1 scope: small) --------------------------------
UNIVERSE_PROFILE=small           # small | medium | full
PERSISTED_TIMEFRAMES=["1h","4h","1d"]

# --- Market data providers ----------------------------------------------
BINANCE_BASE_URL=https://api.binance.com
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
BINANCE_API_KEY=
BINANCE_API_SECRET=

COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=

# Iran stock market — direct TSETMC (see docs/13-data-sources.md)
TSETMC_BASE_URL=http://www.tsetmc.com
TSETMC_CDN_URL=http://cdn.tsetmc.com
TSETMC_USER_AGENT="Mozilla/5.0 (compatible; AMIP/0.1)"
TSETMC_REQUEST_TIMEOUT=20

# Optional outbound proxy for restricted networks (see docs/12-risks.md D2)
HTTP_PROXY=
HTTPS_PROXY=

# --- Resilience defaults -------------------------------------------------
HTTP_MAX_RETRIES=5
HTTP_BACKOFF_BASE_SECONDS=1.0
HTTP_BACKOFF_MAX_SECONDS=60.0
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_SECONDS=60

# --- AI provider ---------------------------------------------------------
AI_PROVIDER=ollama               # ollama | openai | anthropic | gemini | null
OLLAMA_HOST=http://localhost:11434
AI_MODEL=qwen2.5:7b-instruct
AI_TEMPERATURE=0.2
AI_TOP_P=0.9
AI_SEED=42
AI_NUM_CTX=8192
AI_TIMEOUT_SECONDS=90
AI_MAX_CONCURRENCY=1
AI_CACHE_TTL_SECONDS=1800
AI_FALLBACK_PROVIDER=null

# --- Config files --------------------------------------------------------
CONFIG_DIR=./config
